    <Compile Include="ppocr_det.py" />
    <Compile Include="refinement.py" />
    <Compile Include="spelling.py" />
    <Compile Include="toolp.py" />
    <Compile Include="tp.py" />
    <Compile Include="train_trocr.py" />
    <Compile Include="Translator.py" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include="trans9\">
      <Id>trans9</Id>
      <Version>3.9</Version>
      <Description>trans9 (Python 3.9 (64-bit))</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="tool.html" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
