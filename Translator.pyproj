<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>9475954e-5e51-4933-993f-75bf311c698f</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>Translator.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>Translator</Name>
    <RootNamespace>Translator</RootNamespace>
    <InterpreterId>MSBuild|trans9|$(MSBuildProjectFullPath)</InterpreterId>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="detection.py" />
    <Compile Include="EAST.py" />
    <Compile Include="ITT.py" />
    <Compile Include="ITT2.py" />
    <Compile Include="marathiG.py" />
    <Compile Include="marathispeech.py" />
